# 한국관광공사 관광지 집중률 API (scripts/forecast-sync.mjs — 미설정 시 스크립트 내장 기본키 사용)
SERVICE_KEY=

# Vercel Cron 요청 인증 (Vercel 프로젝트 환경변수에 설정. 크론 요청에 자동으로 Bearer 헤더 부착됨)
CRON_SECRET=

# Supabase (pooler - session mode)
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Kakao OAuth (developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키)
KAKAO_REST_API_KEY=
# 카카오 개발자 콘솔에서 "Client Secret"을 활성화한 경우에만 설정 (선택)
KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔 "카카오 로그인 > Redirect URI"에 등록한 값과 정확히 일치해야 함
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# Kakao Maps JavaScript SDK (developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키 — REST API 키가 아님)
NEXT_PUBLIC_KAKAO_JS_KEY=

# OpenAI Responses API (server-only; never expose as NEXT_PUBLIC_*)
OPENAI_API_KEY=
